import os

try:
    from androguard.core.apk import APK
except ImportError as exc:  # pragma: no cover - handled at runtime.
    raise ImportError(
        "Androguard is required. Install the analyzer dependencies with 'pip install -r analyzer/requirements.txt'."
    ) from exc

from .models import ApkAnalysis


def _coerce_version_code(value):
    if value is None or value == "":
        return 0
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def _validate_apk_path(apk_path: str) -> str:
    if not apk_path or not isinstance(apk_path, str):
        raise ValueError("APK path must be a non-empty string.")

    if not os.path.exists(apk_path):
        raise FileNotFoundError(f"APK path does not exist: {apk_path}")

    if not os.path.isfile(apk_path):
        raise ValueError(f"APK path is not a valid file: {apk_path}")

    if not os.access(apk_path, os.R_OK):
        raise PermissionError(f"APK file is not readable: {apk_path}")

    return apk_path


def analyze_apk(apk_path: str) -> ApkAnalysis:
    """Analyze an APK and return a structured summary of the app metadata."""
    validated_path = _validate_apk_path(apk_path)

    try:
        apk = APK(validated_path)
    except Exception as exc:  # pragma: no cover - exercised through real APK parsing.
        raise ValueError(f"Failed to parse APK: {validated_path}") from exc

    try:
        app_name = apk.get_app_name() or ""
        package_name = apk.get_package() or ""
        version_name = apk.get_androidversion_name() or ""
        version_code = _coerce_version_code(apk.get_androidversion_code())
        permissions = apk.get_permissions() or []
    except Exception as exc:  # pragma: no cover - exercised through real APK parsing.
        raise ValueError(f"APK parsing failed for {validated_path}") from exc

    return ApkAnalysis(
        app_name=app_name,
        package_name=package_name,
        version_name=str(version_name),
        version_code=version_code,
        permissions=permissions,
    )
